---
import { Image } from "astro:assets";
import paw from "../assets/brand/paw.png";

interface Props {
  size?: number;
  class?: string;
}
const { size = 17, class: className } = Astro.props;
---

<div class:list={["paw-rule", className]} role="presentation">
  <Image src={paw} alt="" width={size} densities={[1, 2]} />
</div>
