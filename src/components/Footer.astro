---
import { Image } from "astro:assets";
import lockupLight from "../assets/brand/lockup-light.png";
import Icon from "./Icon.astro";
import { NAV, SERVED_ZIPS, SITE, TRUST_LINE } from "../lib/site";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-grid">
    <div>
      <Image src={lockupLight} alt={SITE.name} width={150} densities={[1, 2]} />
      <p class="footer-tagline">{SITE.tagline}</p>
    </div>

    <div>
      <p class="footer-heading">Pages</p>
      <nav class="footer-links" aria-label="Footer">
        <a href="/">Home</a>
        {NAV.map((item) => <a href={item.href}>{item.shortLabel}</a>)}
        <a href="/book">Book a visit</a>
      </nav>
    </div>

    <div>
      <p class="footer-heading">Reach Edward</p>
      <div class="footer-links">
        {/* Phone as real text in a tel: link on every page (Roadmap 2.6.2). */}
        <a href={SITE.phoneHref} class="footer-phone">
          <Icon name="message-square" size={16} />{SITE.phone}
        </a>
        <a href={`mailto:${SITE.email}`} class="footer-email">
          <Icon name="mail" size={16} />{SITE.email}
        </a>
        <a href={SITE.instagram} rel="me noopener">
          <Icon name="instagram" size={16} />{SITE.socialHandle}
        </a>
        <a href={SITE.facebook} rel="me noopener">
          <Icon name="facebook" size={16} />{SITE.socialHandle}
        </a>
      </div>
    </div>

    <div>
      <p class="footer-heading">Service area</p>
      <p class="footer-zips">{SERVED_ZIPS.join(" · ")}</p>
      <p class="footer-fine">
        Other areas by appointment. <a href="/service-area">See the full list →</a>
      </p>
    </div>
  </div>

  <div class="footer-bottom">
    <span>© {year} {SITE.name} · {SITE.city}, {SITE.region}</span>
    <span>{TRUST_LINE}</span>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-brand-green);
    color: var(--color-brand-cream);
    /* Extra bottom padding on mobile so the fixed action bar never covers the
       last row of links. */
    padding: clamp(36px, 5vw, 60px) var(--spacing-gutter) clamp(90px, 10vw, 44px);
  }

  .footer-grid {
    max-width: 1180px;
    margin-inline: auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: clamp(24px, 4vw, 44px);
  }

  .footer-tagline {
    margin: 16px 0 0;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 18px;
    color: rgb(246 237 229 / 0.85);
  }

  .footer-heading {
    margin: 0 0 12px;
    font: 600 11.5px var(--font-body);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgb(246 237 229 / 0.6);
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
  }
  .footer-links a {
    display: flex;
    align-items: center;
    gap: 9px;
    font: 400 15px var(--font-body);
    color: rgb(246 237 229 / 0.9);
    text-decoration: none;
    padding: 8px 0;
    min-height: 40px;
  }
  .footer-links a:hover {
    color: #fff;
  }
  .footer-phone {
    font-weight: 500 !important;
    font-size: 16px !important;
    color: var(--color-brand-cream) !important;
  }
  .footer-email {
    font-size: 14.5px !important;
    word-break: break-word;
  }

  .footer-zips {
    margin: 0;
    font: 400 14.5px/1.7 var(--font-body);
    color: rgb(246 237 229 / 0.88);
  }
  .footer-fine {
    margin: 10px 0 0;
    font: 400 13.5px var(--font-body);
    color: rgb(246 237 229 / 0.65);
  }
  .footer-fine a {
    color: rgb(246 237 229 / 0.9);
  }

  .footer-bottom {
    max-width: 1180px;
    margin: clamp(28px, 4vw, 44px) auto 0;
    padding-top: 20px;
    border-top: 1px solid rgb(246 237 229 / 0.2);
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: space-between;
    font: 400 13px var(--font-body);
    color: rgb(246 237 229 / 0.6);
  }
</style>
