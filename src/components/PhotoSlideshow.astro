---
/**
 * A small, dependency-free slideshow of matted photos.
 *
 * Ships a few lines of vanilla JS rather than a carousel library: this is the
 * only slideshow on the site, and a library would cost more in bytes than the
 * feature is worth. Without JS, the first photo still renders (the others are
 * simply stacked beneath it), so nothing breaks for a no-JS visitor.
 */
import { Image } from "astro:assets";
import type { ResolvedPhoto } from "../lib/photos";

interface Props {
  photos: ResolvedPhoto[];
  ratio?: string;
  width?: number;
  class?: string;
}

const { photos, ratio = "5/4", width = 560, class: className } = Astro.props;
const uid = `slideshow-${Math.random().toString(36).slice(2, 9)}`;
---

<div class:list={["slideshow", className]} id={uid} data-slideshow>
  <div class="slideshow-frame" style={ratio ? `aspect-ratio:${ratio}` : undefined}>
    {
      photos.map((photo, i) => (
        <figure class="slideshow-slide" data-slide aria-hidden={i === 0 ? "false" : "true"}>
          <Image
            src={photo.image}
            alt={photo.alt}
            width={width}
            widths={[400, 800, 1200]}
            sizes="(min-width: 1000px) 33vw, 100vw"
            loading={i === 0 ? "eager" : "lazy"}
            style="object-position:50% 30%"
          />
          <figcaption class="slideshow-caption">{photo.caption}</figcaption>
        </figure>
      ))
    }
  </div>

  {
    photos.length > 1 && (
      <div class="slideshow-dots" role="tablist" aria-label="Photos">
        {photos.map((photo, i) => (
          <button
            type="button"
            class="slideshow-dot"
            data-dot
            role="tab"
            aria-selected={i === 0 ? "true" : "false"}
            aria-label={`Show photo: ${photo.caption}`}
          />
        ))}
      </div>
    )
  }
</div>

<script>
  const AUTO_MS = 5000;

  for (const root of document.querySelectorAll<HTMLElement>("[data-slideshow]")) {
    const slides = Array.from(root.querySelectorAll<HTMLElement>("[data-slide]"));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-dot]"));
    if (slides.length < 2) continue;

    let index = 0;
    let timer: ReturnType<typeof setInterval> | undefined;

    function show(next: number) {
      index = (next + slides.length) % slides.length;
      slides.forEach((s, i) => s.setAttribute("aria-hidden", i === index ? "false" : "true"));
      dots.forEach((d, i) => d.setAttribute("aria-selected", i === index ? "true" : "false"));
    }

    function start() {
      stop();
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (reduced) return;
      timer = setInterval(() => show(index + 1), AUTO_MS);
    }
    function stop() {
      if (timer) clearInterval(timer);
    }

    dots.forEach((dot, i) => {
      dot.addEventListener("click", () => {
        show(i);
        start();
      });
    });

    root.addEventListener("mouseenter", stop);
    root.addEventListener("mouseleave", start);
    root.addEventListener("focusin", stop);
    root.addEventListener("focusout", start);

    start();
  }
</script>

<style>
  .slideshow {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .slideshow-frame {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    background: var(--color-brand-photo);
  }
  .slideshow-slide {
    margin: 0;
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.6s ease;
  }
  .slideshow-slide[aria-hidden="false"] {
    opacity: 1;
    z-index: 1;
  }
  .slideshow-slide :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .slideshow-caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    margin: 0;
    padding: 8px 14px;
    font: 500 13px var(--font-body);
    color: #fff;
    background: linear-gradient(to top, rgb(0 0 0 / 0.55), transparent);
  }
  .slideshow-dots {
    display: flex;
    justify-content: center;
    gap: 8px;
  }
  .slideshow-dot {
    width: 9px;
    height: 9px;
    padding: 0;
    border-radius: 50%;
    border: 1px solid var(--color-brand-brown);
    background: transparent;
    cursor: pointer;
  }
  .slideshow-dot[aria-selected="true"] {
    background: var(--color-brand-brown);
  }
</style>
