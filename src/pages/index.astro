---
import Base from "../layouts/Base.astro";
---

<Base title="Edventures Pet Sitting | Philadelphia">
  <main class="mx-auto max-w-2xl px-6 py-24 text-center">
    <h1 class="heading-brand text-5xl">Edventures Pet Sitting</h1>

    <p class="mt-4 text-brand-brown tracking-widest uppercase text-sm">
      Adventurous care. Tailored for your pet.
    </p>

    <div class="mt-12 rounded-lg border border-brand-brown/15 bg-brand-card p-8">
      <p class="text-brand-ink">
        Scaffold placeholder &mdash; Phase 0.1 complete.
      </p>
      <p class="mt-2 text-sm text-brand-ink/70">
        Real pages land in Phase 2. Until then, to book a visit:
      </p>
      <p class="mt-6">
        <a
          href="tel:+16108884541"
          class="inline-block rounded-md bg-brand-green px-6 py-3 text-brand-cream"
        >
          Text 610-888-4541
        </a>
      </p>
    </div>
  </main>
</Base>
